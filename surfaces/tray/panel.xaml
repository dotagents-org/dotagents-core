<!-- The tray panel's window (ADR 0010): borderless, above the clock, closed when it loses focus.
     tray.ps1 fills the cards and the colors; this is the frame. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dotagents"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Geist Mono, Cascadia Mono, Consolas"
        FontSize="12">
  <Border x:Name="Frame" CornerRadius="12" BorderThickness="1" Padding="16" Margin="8">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25"/>
    </Border.Effect>
    <StackPanel>
      <DockPanel Margin="0,0,0,12">
        <Button x:Name="Refresh" DockPanel.Dock="Right" Width="30" Height="30" Cursor="Hand" ToolTip="Refresh" AutomationProperties.Name="Refresh" BorderThickness="1" Background="Transparent">
          <Path x:Name="RefreshIcon" Data="M12,4 A8,8 0 1 0 19.6,9.5 M20,3 L20,9 L14,9" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14"/>
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="Badge" CornerRadius="3" Padding="7,2">
            <TextBlock x:Name="BadgeText" Text="dotagents" FontWeight="SemiBold" FontSize="13"/>
          </Border>
          <TextBlock x:Name="Age" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
      <StackPanel x:Name="Cards"/>
      <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
      <DockPanel Margin="0,10,0,0">
        <TextBlock x:Name="Dashboard" DockPanel.Dock="Right" Cursor="Hand" TextDecorations="Underline" Text="Open dashboard"/>
        <TextBlock x:Name="Sides"/>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
