{
  "name": "dotagents-accounts",
  "displayName": "dotagents-accounts",
  "description": "Your Claude accounts in VS Code: the current one and its usage in the status bar, every account in the side bar, and the switch.",
  "version": "3.0.0",
  "publisher": "gabrieldulolmarques",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": { "type": "git", "url": "https://github.com/dotagents-org/dotagents-core.git" },
  "categories": ["Other"],
  "scripts": {
    "package": "node copy-panel.mjs && npx --yes @vscode/vsce@3 package --no-dependencies --skip-license -o dotagents-accounts.vsix"
  },
  "engines": { "vscode": "^1.90.0" },
  "extensionKind": ["workspace"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "icons": {
      "dotagents-accounts": { "description": "The dotagents accounts mark", "default": { "fontPath": "media/icons.woff", "fontCharacter": "\\E001" } }
    },
    "viewsContainers": {
      "activitybar": [{ "id": "dotagents", "title": "dotagents", "icon": "media/icon.svg" }]
    },
    "views": {
      "dotagents": [{ "type": "webview", "id": "dotagents.panel", "name": "Accounts" }]
    },
    "commands": [
      { "command": "dotagents.switch", "title": "dotagents-accounts: Switch Account" },
      { "command": "dotagents.openInBrowser", "title": "dotagents-accounts: Open the Panel in the Browser", "icon": "$(link-external)" }
    ],
    "menus": {
      "view/title": [{ "command": "dotagents.openInBrowser", "when": "view == dotagents.panel", "group": "navigation@1" }]
    }
  }
}
