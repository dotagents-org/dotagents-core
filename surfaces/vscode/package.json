{
  "name": "dotagents",
  "displayName": "dotagents",
  "description": "Your Claude accounts in VS Code: the current one and its usage in the status bar, every account in the side bar, and the switch.",
  "version": "3.0.0",
  "publisher": "gabrieldulolmarques",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/dotagents-org/dotagents-cli.git" },
  "categories": ["Other"],
  "scripts": {
    "package": "node copy-panel.mjs && npx --yes @vscode/vsce@3 package --no-dependencies --skip-license -o dotagents.vsix"
  },
  "engines": { "vscode": "^1.90.0" },
  "extensionKind": ["workspace"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "dotagents", "title": "dotagents", "icon": "media/icon.svg" }]
    },
    "views": {
      "dotagents": [{ "type": "webview", "id": "dotagents.panel", "name": "Accounts" }]
    },
    "commands": [
      { "command": "dotagents.switch", "title": "dotagents: Switch account" },
      { "command": "dotagents.openInBrowser", "title": "dotagents: Open the panel in the browser", "icon": "$(link-external)" }
    ],
    "menus": {
      "view/title": [{ "command": "dotagents.openInBrowser", "when": "view == dotagents.panel", "group": "navigation@1" }]
    }
  }
}
